  "_howSourcesArrive": "Each source can use ANY ONE of: 'file' (a JSON file your connector writes), 'url' (an endpoint returning JSON), or 'apify' (run an actor). Sources not yet wired just no-op, so a partial run still emails.",

  "sources": [
    {
      "name": "Facebook Marketplace",
      "type": "facebook",
      "max": 5,
      "requireKeywords": true,
      "apify": {
        "actorId": "apify/facebook-marketplace-scraper",
        "input": {
          "startUrls": [ { "url": "https://www.facebook.com/marketplace/galveston/propertyrentals" } ],
          "resultsLimit": 40,
          "includeListingDetails": true
        }
      }
    },
    { "name": "Apartments.com", "type": "apartments",    "max": 2, "requireKeywords": false, "file": "data/incoming/apartments.json" },
    { "name": "Zillow",         "type": "zillow",        "max": 2, "requireKeywords": false, "file": "data/incoming/zillow.json" },
    { "name": "Apartment List", "type": "apartmentlist", "max": 2, "requireKeywords": false, "file": "data/incoming/apartmentlist.json" },
