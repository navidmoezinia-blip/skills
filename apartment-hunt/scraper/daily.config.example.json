    "utilitiesIncludedPhrases": ["utilities included", "utils included", "all bills paid", "includes utilities", "water included", "electric included"],
    "utilitiesExcludedPhrases": ["tenant pays", "plus utilities", "+ utilities", "utilities not included", "excludes utilities"]
